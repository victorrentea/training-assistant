@startuml
title Quiz
hide footbox
autonumber

skinparam BackgroundColor transparent
skinparam SequenceMessageAlign center
skinparam ParticipantPadding 20
skinparam BoxPadding 10
skinparam MaxMessageSize 110
skinparam WrapWidth 220
skinparam RoundCorner 8

actor "Host browser\nstatic/host.js" as Host
actor "Participant browser" as Participant
participant "Daemon quiz queue router\n/api/{session}/host/quiz/queue" as QuizQueueAPI
collections "Quiz queue\n(in memory)" as QuizQueue
participant "Daemon quiz router\n/api/.../quiz" as QuizAPI
participant "Railway HTTP proxy" as RailwayHTTP
participant "Railway session WS" as RailwayWS

group Queue pre-written questions (no LLM in the daemon)
Host -> QuizQueueAPI: POST /quiz/queue {questions}
QuizQueueAPI -> QuizQueue: replace the whole queue
QuizQueueAPI -> Host: notify_host quiz_queue_updated
end

group Fire -> vote -> end -> reveal
Host -> QuizAPI: POST /host/quiz/manual/submit {question, options}
QuizAPI -> QuizAPI: create and open the quiz\nset current_activity="quiz"
QuizAPI -> RailwayWS: broadcast quiz_opened
QuizAPI -> Host: notify_host quiz_opened
Host -> QuizQueueAPI: DELETE /quiz/queue/{index}\n(when fired from the queue)

Participant -> RailwayHTTP: POST /api/participant/quiz/vote
RailwayHTTP -> QuizAPI: proxy vote request
QuizAPI -> QuizAPI: cast_vote (votes stay mutable while open)
QuizAPI -> RailwayWS: write_back vote_update
QuizAPI -> Host: notify_host vote_update

opt Host starts a countdown
  Host -> QuizAPI: POST /host/quiz/end/timer {seconds}
  QuizAPI -> RailwayWS: broadcast quiz_end_countdown_started
  QuizAPI -> Host: notify_host quiz_end_countdown_started
end

Host -> QuizAPI: POST /host/quiz/end
QuizAPI -> RailwayWS: broadcast quiz_ended
QuizAPI -> Host: notify_host quiz_ended

opt Host reveals correct answers after closing
  Host -> QuizAPI: PUT /host/quiz/correct
  QuizAPI -> QuizAPI: reveal correct_ids\naward scores
  QuizAPI -> RailwayWS: broadcast quiz_correct_revealed
  QuizAPI -> RailwayWS: broadcast scores_updated
  QuizAPI -> Host: notify_host scores_updated
end
end
@enduml
