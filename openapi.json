    "/api/{session_id}/api/slides/invalidate/{slug}": {
      "post": {
        "summary": "Invalidate Slide",
        "description": "Force Railway to re-download and cache-bust the PDF for slug.\n\nCalled by the slides upload daemon after it detects a PPTX was saved and\nGoogle Drive has the updated PDF. Railway deletes the old cached file,\nre-downloads from Drive, then broadcasts slides_cache_status with\nrefreshed_slugs so connected participants auto-reload the active slide.",
        "operationId": "invalidate_slide_api__session_id__api_slides_invalidate__slug__post",
        "security": [
          {
            "HTTPBasic": []
          }
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          },
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/SlideInvalidateRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
